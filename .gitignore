# Block massive dataset & temporary DuckDB files
*.csv
*.parquet
*.duckdb
*.wal
data/
raw_data/

# Allow lightweight aggregated summary CSVs & generated chart PNGs
!outputs/
!outputs/tables/
!outputs/tables/*.csv
!outputs/charts/
!outputs/charts/*.png

# Python & OS clutter
__pycache__/
.venv/
venv/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
